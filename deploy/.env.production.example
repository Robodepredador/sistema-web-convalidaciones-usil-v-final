# Plantilla de producción — Sistema de Convalidaciones USIL
#
# Copiar a `.env` en la raíz del proyecto y completar todos los __definir__.
# Procedimiento completo: deploy/RUNBOOK.md

APP_NAME="Convalidaciones USIL"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://__definir__.usil.edu.pe

# APP_KEY se genera UNA SOLA VEZ, en la instalación inicial, y se respalda.
# Cifra las API keys guardadas en la tabla `configuraciones`: regenerarla las
# vuelve indescifrables y cierra todas las sesiones activas.
APP_KEY=

# --- Base de datos (MySQL 8, motor InnoDB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=convalidaciones_usil
DB_USERNAME=__definir__
DB_PASSWORD=__definir__

# --- Colas y caché ---
# Sobre MySQL: no hace falta Redis. Las tablas las crean las migraciones.
# La carga masiva de mallas (RF-11) necesita que el worker corra por cron;
# sin él las importaciones quedan encoladas para siempre. Ver RUNBOOK §6.
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# --- Correo: OBLIGATORIO ---
# Es el único canal por el que se entregan las contraseñas. Sin esto nadie puede
# iniciar sesión salvo el administrador inicial. Si falla, el sistema lo dice en
# pantalla y queda `php artisan usuario:password {correo}` como salida manual.
MAIL_MAILER=smtp
MAIL_HOST=__definir__
MAIL_PORT=587
MAIL_USERNAME=__definir__
MAIL_PASSWORD=__definir__
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-responder@usil.edu.pe"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sesión ---
# ATENCIÓN: SESSION_SECURE_COOKIE=true exige HTTPS. Si el sitio se publica
# primero por HTTP, la cookie no viaja y NADIE puede iniciar sesión, sin ningún
# mensaje que lo explique. Déjalo en false hasta que el certificado esté activo
# y ponlo en true el mismo día que se active.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Motor de IA: se entrega APAGADO ---
# Sin clave, el sistema propone equivalencias por similitud de nombres y no envía
# nada fuera. Activarlo transfiere datos personales del postulante a un proveedor
# externo fuera del país (Ley N.° 29733) y exige autorización escrita del área
# legal de USIL. La clave se puede cargar también desde la propia aplicación
# (Configuración), donde se guarda cifrada con APP_KEY.
IA_PROVEEDOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Otros ---
BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
