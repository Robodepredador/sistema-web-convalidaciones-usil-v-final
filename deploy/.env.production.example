APP_NAME="Convalidaciones USIL"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://convalidaciones.usil.edu.pe

# ATENCIÓN: APP_KEY se genera UNA SOLA VEZ, en la primera instalación, y se
# respalda. Cifra las API keys guardadas en `configuraciones`; regenerarla las
# vuelve indescifrables y cierra todas las sesiones activas.

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=convalidaciones_usil
DB_USERNAME=usil
DB_PASSWORD=__definir__
DB_ROOT_PASSWORD=__definir__

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database
REDIS_HOST=redis
REDIS_PORT=6379

# Cookies de sesión solo por HTTPS (RNF-01).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Correo — OBLIGATORIO. Sin esto MAIL_MAILER cae a 'log' y las credenciales de
# acceso del postulante y el "olvidé mi contraseña" se escriben en el archivo de
# log en vez de enviarse. El sistema no avisa: el flujo parece correcto.
MAIL_MAILER=smtp
MAIL_HOST=__definir__
MAIL_PORT=587
MAIL_USERNAME=__definir__
MAIL_PASSWORD=__definir__
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-responder@usil.edu.pe"
MAIL_FROM_NAME="${APP_NAME}"

# IA — la clave nunca se versiona (RNF-09). Se puede definir aquí o cargarla
# desde Configuración en la propia aplicación (se guarda cifrada con APP_KEY).
IA_PROVEEDOR=gemini
GEMINI_API_KEY=__definir__
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
