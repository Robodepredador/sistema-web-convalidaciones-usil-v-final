APP_NAME="Convalidaciones USIL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Base de datos: MySQL 8 (motor InnoDB) — decisión confirmada
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=convalidaciones_usil
DB_USERNAME=root
DB_PASSWORD=

# Colas y caché sobre MySQL (RF-11: la carga masiva corre en segundo plano).
#
# Se usaba Redis. Se retiró: es una pieza más que instalar, vigilar y respaldar,
# y para el volumen real de este sistema —unas pocas importaciones de malla al
# día— MySQL sobra. Las tablas `jobs`, `failed_jobs`, `job_batches` y `cache`
# las crean las migraciones.
QUEUE_CONNECTION=database
CACHE_STORE=database

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Correo — el ÚNICO canal por el que se entregan las contraseñas, del personal y
# del postulante. Con 'log' el mensaje se escribe en storage/logs y NO se envía:
# el sistema lo avisa en pantalla, pero nadie puede entrar. En producción esto es
# obligatorio (ver deploy/RUNBOOK.md, §3).
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@usil.edu.pe"
MAIL_FROM_NAME="${APP_NAME}"

# Motor de IA: APAGADO. Dejar estas variables vacías.
#
# El motor salió del flujo el 15/08/2026 —el Especialista declara las
# equivalencias de antemano y no queda nada que sugerir—, así que el sistema no
# llama a ningún proveedor externo. El andamiaje sigue en el código, inerte y sin
# pantalla que lo alcance; estas variables se conservan por si algún día se
# reactiva. Hacerlo exige autorización escrita del área legal de USIL: enviaría
# el récord académico del postulante —nombre, documento y notas— fuera del país
# (Ley N.° 29733).
IA_PROVEEDOR=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Seguridad
BCRYPT_ROUNDS=12

# Idioma de la interfaz y de los mensajes de validación.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
